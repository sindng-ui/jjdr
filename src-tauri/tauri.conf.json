{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jjdr",
  "version": "0.4.8",
  "identifier": "com.jjdr.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "jjdr — Mission Control",
        "width": 1380,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#101526"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
